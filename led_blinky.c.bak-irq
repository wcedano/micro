#include "board.h"
#include "app.h"
#include "fsl_debug_console.h"

/*******************************************************************************
 * Definitions
 ******************************************************************************/

/*******************************************************************************
 * Prototypes
 ******************************************************************************/
void color_change(void);
void color_loop_speed_change(void);


/*******************************************************************************
 * Variables
 ******************************************************************************/
uint8_t n = 0;
uint32_t timedalay = 500000; /* 500ms delay */
bool flag_change_color = false;
bool buttonPressed = false;

/*******************************************************************************
 * Code
 ******************************************************************************/
void SysTick_Handler(void)
{
    /* Toggle pin connected to LED */
    //GPIO_PortToggle(BOARD_LED_GPIO, 1u << BOARD_LED_GPIO_PIN);
}

/* =========================================================
 * GPIO1 INTERRUPT
 * ========================================================= */
/* GPIO1_IRQn interrupt handler */

void INT_0_IRQHANDLER(void) {
  uint32_t flags;

    flags = GPIO_PortGetInterruptFlags(BOARD_SW2_GPIO);

    if (flags & (1UL << BOARD_SW2_GPIO_PIN))
    {
        /* IMPORTANTE: limpiar el flag */
        GPIO_PortClearInterruptFlags(
            BOARD_SW2_GPIO,
            1UL << BOARD_SW2_GPIO_PIN
        );

        buttonPressed = true;
    }
  /* Add for ARM errata 838869, affects Cortex-M4, Cortex-M4F
     Store immediate overlapping exception return operation might vector to incorrect interrupt. */
  #if defined __CORTEX_M && (__CORTEX_M == 4U)
    __DSB();
  #endif
}


/*!
 * @brief Main function
 */
int main(void)
{
    /* Board pin init */
    /* BOARD_InitHardware() ya inicializa la consola (BOARD_InitDebugConsole) */
    BOARD_InitHardware();
    EnableIRQ(BOARD_SW2_IRQ);
  

    DbgConsole_Printf("\r\n=== rgb_control: consola lista ===\r\n");
    DbgConsole_Printf("Para cambiar el color del LED pulse un botón SW2\n");
    DbgConsole_Printf("Para cmbiar la velocidad de parpadeo del LED pulse un botón SW3\n");

    while (1)
    {
        if (GPIO_PinRead(BOARD_SW2_GPIO, BOARD_SW2_GPIO_PIN) == 0)
        {
            DbgConsole_Printf("SW2 pulsado: cambio de color del LED\r\n");
            /* Cambiar el color del LED */
            color_change();
            flag_change_color = false;
        }
        else if (GPIO_PinRead(BOARD_SW3_GPIO, BOARD_SW3_GPIO_PIN) == 0)
        {
            DbgConsole_Printf("SW3 pulsado: cambio de velocidad del LED\r\n");
            /* Cambiar la velocidad de parpadeo del LED */
            timedalay = (timedalay * 0.8); // Cambiar la velocidad de parpadeo del LED a 80% de la velocidad actual
            if (timedalay < 5000)
            {
                timedalay = 50000000; // Reiniciar la velocidad de parpadeo del LED a 500ms si es menor a 5ms
            }
            flag_change_color = true;
        }
        else
        {
            /* code */
        }

        if (flag_change_color)
        {
            color_loop_speed_change();
        }       
    }
}

/*Color change function*/
/*@brief Changes the color of the LED */
void color_change(void)
{
    GPIO_PinWrite(BOARD_LED_RED_GPIO, BOARD_LED_RED_GPIO_PIN, (n >> 2) & 1);
    GPIO_PinWrite(BOARD_LED_GREEN_GPIO, BOARD_LED_GREEN_GPIO_PIN, (n >> 1) & 1);
    GPIO_PinWrite(BOARD_LED_BLUE_GPIO, BOARD_LED_BLUE_GPIO_PIN, n & 1);
    n = (n + 1) % 8;
}

/*color loop speed change function*/
void color_loop_speed_change(void)
{
        GPIO_PinWrite(BOARD_LED_RED_GPIO, BOARD_LED_RED_GPIO_PIN, (n >> 2) & 1);
        GPIO_PinWrite(BOARD_LED_GREEN_GPIO, BOARD_LED_GREEN_GPIO_PIN, (n >> 1) & 1);
        GPIO_PinWrite(BOARD_LED_BLUE_GPIO, BOARD_LED_BLUE_GPIO_PIN, n & 1);
        n = (n + 1) % 8;
        SDK_DelayAtLeastUs(timedalay, SDK_DEVICE_MAXIMUM_CPU_CLOCK_FREQUENCY);
}